{
  "name": "toursafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,blue \"tsx watch backend/src/index.ts\" \"vite --config frontend/vite.config.ts\"",
    "build": "tsc -p backend/tsconfig.json && tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node dist/backend/src/index.js",
    "test": "tsx --test backend/src/utils/core.test.ts backend/src/adapters/adapters.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
