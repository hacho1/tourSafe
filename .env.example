# Copy to .env in the project root. Use decoded public-data service keys.
PORT=8787
HOST=127.0.0.1
USE_MOCK_DATA=true

# Live TourAPI takes priority over demo mode when this key is set.
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# Uses TOUR_API_KEY when blank; the separate accessibility service must be approved.
ACCESSIBLE_TOUR_API_KEY=
ACCESSIBLE_TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorWithService2
TOURISM_STANDARD_FILE=backend/data/tourism-standard/전국관광지정보표준데이터.csv
WEATHER_API_KEY=
MEDICAL_API_KEY=
# National Medical Center: hospital/clinic search (data.go.kr/15000736), separate service approval.
HOSPITAL_API_KEY=
TOURIST_INFO_API_KEY=
TOILET_API_KEY=
KAKAO_REST_API_KEY=
# Public CSV import directory. Import the supplied CSVs first; see README.
PUBLIC_FACILITIES_DIR=backend/data/public-facilities

# Optional legacy DEMO map SDK. LIVE uses TourSafe-styled OpenFreeMap without a key.
# Browser JavaScript key only; register the exact web domain in Kakao Developers.
VITE_KAKAO_MAP_KEY=

# Optional verified closure/access-control overrides; see README.
# Path relative to the project root, for example backend/data/closures.json
CLOSURE_DATA_FILE=
